# cp terraform.tfvars.example terraform.tfvars して編集（terraform.tfvars は .gitignore 済み）
alert_email = "you@example.com"

# GuardDuty を既に有効化しているアカウントなら false
enable_guardduty = true

# 1,000円 / 為替（約150〜155円/USD）
budget_usd = 6.5

# スマホからの緊急隔離（GitHub Actions）。リポジトリを作ったら owner/name を入れる
github_repo = "shinji0214/HoneyPot-in-aws"
# アカウントに GitHub の OIDC プロバイダが既にあれば false
create_github_oidc_provider = true
